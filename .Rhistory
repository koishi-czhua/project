add_recipe(pokemon_recipe) %>%
add_model(random_forest)
# Create a regular grid for mtry, trees, and min_n
grid_rf <- expand.grid(mtry = 1:8, trees = seq(100, 800, length = 8), min_n = seq(2, 10, length = 8))
cl <- makeCluster(detectCores() - 1)
registerDoParallel(cl)
# Fit the model using the workflow
results_elastic_net <- tune_grid(
elastic_net_workflow,
resamples = vfold_cv(train_data, v = 5, strata = type_1),
grid = grid
)
results_rf <- tune_grid(
random_forest_workflow,
resamples = vfold_cv(train_data, v = 5, strata = type_1),
grid = grid_rf
)
stopCluster(cl)
# Plot the results
autoplot(results_elastic_net)
autoplot(results_rf)
# Select the optimal random forest model
