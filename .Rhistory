# Data for the problem
data <- data.frame(
Region = c("North", "Yorkshire", "Northeast", "East Midlands", "West Midlands",
"East Anglia", "Southeast", "Southwest", "Wales", "Scotland", "Northern Ireland"),
Alcohol = c(6.47, 6.13, 6.19, 4.89, 5.63, 4.52, 5.89, 4.79, 5.27, 6.08, 4.02),
Tobacco = c(4.03, 3.76, 3.77, 3.34, 3.47, 2.92, 3.20, 2.71, 3.53, 4.51, 4.56)
)
# Scatter plot
plot(data$Tobacco, data$Alcohol,
xlab = "Tobacco Spending (pounds)",
ylab = "Alcohol Spending (pounds)",
main = "Scatter Plot of Alcohol vs Tobacco Spending")
# Fitting the linear regression model
model <- lm(Alcohol ~ Tobacco, data = data)
# Summary of the model
summary(model)
# Adding the fitted line to the scatter plot
abline(model, col = "blue")
plot(data$Tobacco, data$Alcohol,
xlab = "Tobacco Spending (pounds)",
ylab = "Alcohol Spending (pounds)",
main = "Scatter Plot of Alcohol vs Tobacco Spending")
# Fitting the linear regression model
model <- lm(Alcohol ~ Tobacco, data = data)
# Summary of the model
summary(model)
# Adding the fitted line to the scatter plot
abline(model, col = "blue")
# Calculate leverage values
leverage_values <- hatvalues(model)
leverage_values
# Calculate Cook's distance
cooks_distance <- cooks.distance(model)
cooks_distance
# Identify the region with the highest Cook's distance
max_cooks_region <- data$Region[which.max(cooks_distance)]
max_cooks_region
# Calculate Cook's distance
cooks_distance <- cooks.distance(model)
cooks_distance
# Identify the region with the highest Cook's distance
max_cooks_region <- data$Region[which.max(cooks_distance)]
max_cooks_region
# Refit model without the most influential point
data_no_influential <- data[data$Region != max_cooks_region, ]
model_no_influential <- lm(Alcohol ~ Tobacco, data = data_no_influential)
# Compare the summaries
summary(model)
summary(model_no_influential)
# Scatter plot with both fits
par(mfrow = c(1, 2))
plot(data$Tobacco, data$Alcohol,
xlab = "Tobacco Spending (pounds)",
ylab = "Alcohol Spending (pounds)",
main = "With Influential Point")
abline(model, col = "blue")
plot(data_no_influential$Tobacco, data_no_influential$Alcohol,
xlab = "Tobacco Spending (pounds)",
ylab = "Alcohol Spending (pounds)",
main = "Without Influential Point")
abline(model_no_influential, col = "red")
# Scatter plot with both fits
par(mfrow = c(1, 2))
plot(data$Tobacco, data$Alcohol,
xlab = "Tobacco Spending (pounds)",
ylab = "Alcohol Spending (pounds)",
main = "With Influential Point")
abline(model, col = "blue")
plot(data_no_influential$Tobacco, data_no_influential$Alcohol,
xlab = "Tobacco Spending (pounds)",
ylab = "Alcohol Spending (pounds)",
main = "Without Influential Point")
abline(model_no_influential, col = "red")
